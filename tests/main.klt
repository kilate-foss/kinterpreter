native work Print(value: Int): Long

work GetName(): String {
        let a: String = "Aquiles Trindade"
        return a
}

work GetAge(): Int {
        let a: Int = 15
        return a
}

work Main(): Int {
        let name: String = GetName()
        let age: Int = GetAge()
        Print -> name, " ", age
        return -> 0
}
